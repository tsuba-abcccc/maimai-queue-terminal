# The personal web account API must be proxied as a group. Keep the exact
# collection endpoint below because the slash-prefixed location does not match
# /api/player-account itself.
location = /api/player-account {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 1m;
}

location ^~ /api/player-account/ {
    proxy_pass http://127.0.0.1:8081;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 1m;
}

location = /queue-api-healthz {
    proxy_pass http://127.0.0.1:8081/healthz;
    proxy_set_header Host $host;
}
